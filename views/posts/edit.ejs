<h1>Edit Post</h1>

<form
    action="/posts/<%= post._id %>"
    method="POST"
>
    <label for="text">Post:</label>

    <br>

    <textarea
        id="text"
        name="text"
        rows="6"
        cols="50"
        required
    ><%= post.text %></textarea>

    <% if (post.locationName && post.weather) { %>
        <div class="post-meta-widget">
            <span class="post-location">
                📍 <%= post.locationName %>
            </span>

            <span class="post-weather">
                <img
                    class="post-weather-icon"
                    src="https://openweathermap.org/img/wn/<%= post.weather.icon %>.png"
                    alt="<%= post.weather.description %>"
                >
                <strong><%= post.weather.temp %>°C</strong>,
                <%= post.weather.description %>
            </span>
        </div>
    <% } %>

    <button type="submit">
        Save Changes
    </button>
</form>

<br>

<a href="/">Cancel</a>
