<h1>Create Post</h1>

<form
    class="post-location-form"
    data-post-location-form
    action="/posts"
    method="POST"
    enctype="multipart/form-data"
>

    <label for="text">Post:</label>

    <br>

    <textarea
        id="text"
        name="text"
        rows="6"
        cols="50"
        required
    ></textarea>

    <br><br>

    <label for="media">Image or Video:</label>

    <br>

    <input
        type="file"
        id="media"
        name="media"
        accept="image/*,video/*"
    >

    <input type="hidden" name="lat" data-post-lat>
    <input type="hidden" name="lon" data-post-lon>

    <p data-post-location-status>
        Your posting location and weather will be saved when you publish.
    </p>

    <br>

    <div class="discord-share-container">
        <input type="checkbox" id="postToDis" name="postToDiscord" value="true">
        <label for="postToDis">Post to Discord</label>
    </div>

    <button type="submit">
        Publish
    </button>

</form>

<a href="/">Cancel</a>
