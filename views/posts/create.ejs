<h1>Create Post</h1>

<form
    action="/posts"
    method="POST"
    enctype="multipart/form-data"
>

    <label for="text">Post:</label>

    <br>

    <textarea
        id="text"
        name="text"
        rows="6"
        cols="50"
        required
    ></textarea>

    <br><br>

    <label for="media">Image or Video:</label>

    <br>

    <input
        type="file"
        id="media"
        name="media"
        accept="image/*,video/*"
    >

    <br><br>

    <button type="submit">
        Publish
    </button>

</form>

<a href="/">Cancel</a>