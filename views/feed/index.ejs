<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="UTF-8">

    <title>Home</title>

</head>

<body>

    <h1>Feed</h1>

    <a href="/posts/create">Create Post</a>

    <hr>


    <% if (posts.length === 0) { %>

        <p>No posts yet.</p>

    <% } else { %>


        <% posts.forEach(post => { %>

            <article>

                <div class="post-layout">
                    <img src="<%= post.authorDetails.avatarUrl %>" alt="Avatar" class="avatar-small">
                    <div class="post-content">
                        <strong><%= post.authorDetails.displayName %></strong>
                        <p><%= post.text %></p>
                    </div>
                </div>


                <% if (post.type === "image" && post.mediaUrl) { %>
                    <img src="<%= post.mediaUrl %>" alt="Post image">
                <% } %>


                <% if (post.type === "video" && post.mediaUrl) { %>
                    <video controls>
                        <source src="<%= post.mediaUrl %>">
                        Your browser does not support video. </video>
                <% } %>

                <small>
                    <%= post.createdAt %>
                </small>

                
                <% if (post.author.toString() === userId) { %>
                    <div class="post-actions">
                        <a href="/posts/<%= post._id %>/edit">Edit</a>
                        <form action="/posts/<%= post._id %>/delete" method="POST">
                            <button type="submit">Delete</button>
                        </form>
                    </div>
                <% } %>

            </article>

            <hr>

        <% }) %>


    <% } %>


</body>

</html>