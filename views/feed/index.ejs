<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Home</title>
</head>

<body>
<h1>Feed</h1>

<a href="/posts/create">Create Post</a>

<hr>

<% if (posts.length === 0) { %>

    <p>No posts yet.</p>

<% } else { %>

    <% posts.forEach(post => { %>

        <article>

            <p>
                <%= post.text %>
            </p>

            <small>
                <%= post.createdAt %>
            </small>

            <% if (post.author.toString() === userId) { %>

                <form
                    action="/posts/<%= post._id %>/delete"
                    method="POST"
                >
                    <button type="submit">
                        Delete
                    </button>
                </form>

            <% } %>

        </article>

        <hr>

    <% }) %>

<% } %>

</body>
</html>