<% if (posts.length === 0) { %>
    <div class="friends-empty feed-empty">
        <h2>Nothing here yet</h2>
        <p><%= emptyMessage || 'No posts yet.' %></p>
    </div>
<% } else { %>
    <div class="social-post-list">
        <% posts.forEach(post => { %>
            <% const author = post.authorDetails || null; %>
            <article class="social-post">
                <div class="social-post-header">
                    <% if (author) { %>
                        <a href="/users/<%= author._id %>">
                            <img
                                src="<%= author.avatarUrl || '/images/default-avatar.png' %>"
                                alt="<%= author.displayName %>'s avatar"
                                class="social-post-avatar"
                            >
                        </a>
                        <div class="social-post-author">
                            <div class="social-post-author-line">
                                <a href="/users/<%= author._id %>">
                                    <strong><%= author.displayName %></strong>
                                </a>
                                <% if (author.isPrivate === true) { %>
                                    <span class="post-private-badge">Private</span>
                                <% } %>
                            </div>
                            <span>@<%= author.username %></span>
                        </div>
                    <% } else { %>
                        <div class="social-post-author">
                            <strong>Former user</strong>
                        </div>
                    <% } %>
                    <time class="social-post-time" datetime="<%= post.createdAt %>">
                        <%= new Date(post.createdAt).toLocaleString() %>
                    </time>
                </div>

                <p class="social-post-text"><%= post.text %></p>

                <% if (post.type === "image" && post.mediaUrl) { %>
                    <img
                        class="social-post-media"
                        src="<%= post.mediaUrl %>"
                        alt="Post image"
                    >
                <% } %>

                <% if (post.type === "video" && post.mediaUrl) { %>
                    <video
                        class="social-post-media"
                        controls
                        preload="metadata"
                    >
                        <source
                            src="<%= post.mediaUrl %>"
                            type="video/mp4"
                        >
                        <a href="<%= post.mediaUrl %>">Open video</a>
                    </video>
                <% } %>

                <% if (post.locationName || post.weather) { %>
                    <div class="post-meta-widget">
                        <% if (post.locationName) { %>
                            <a
                                class="post-location post-location-link"
                                href="/map?post=<%= post._id %>"
                                title="Show directions to this post location"
                            >
                                📍 <%= post.locationName %>
                            </a>
                        <% } %>

                        <% if (post.weather) { %>
                            <span class="post-weather">
                                <img
                                    class="post-weather-icon"
                                    src="https://openweathermap.org/img/wn/<%= post.weather.icon %>.png"
                                    alt="<%= post.weather.description %>"
                                >
                                <strong><%= post.weather.temp %>°C</strong>,
                                <%= post.weather.description %>
                            </span>
                        <% } %>
                    </div>
                <% } %>

                <% if (post.author && post.author.toString() === userId) { %>
                    <div class="social-post-actions">
                        <a href="/posts/<%= post._id %>/edit">Edit</a>
                        <form
                            class="friend-action-form"
                            action="/posts/<%= post._id %>/delete"
                            method="POST"
                            onsubmit="return confirm('Delete this post?');"
                        >
                            <input
                                type="hidden"
                                name="returnTo"
                                value="<%= returnTo %>"
                            >
                            <button
                                class="post-delete-btn"
                                type="submit"
                            >
                                Delete
                            </button>
                        </form>
                    </div>
                <% } %>
            </article>
        <% }) %>
    </div>
<% } %>
