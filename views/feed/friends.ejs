<section class="social-feed-page">
    <div class="feed-heading">
        <div>
            <span class="friends-eyebrow">Your network</span>
            <h1>Friends Feed</h1>
            <p>Posts only from people on your friends list.</p>
        </div>

        <a class="friend-btn friend-btn-link" href="/posts/create">Create post</a>
    </div>

    <%- include("_tabs", { activeFeed }) %>

    <%- include("_posts", {
        posts,
        userId,
        returnTo: "/feed/friends",
        emptyMessage: "Your friends have not posted anything yet. Add friends or check back later."
    }) %>
</section>
