<section class="profile-edit-page">
    <div class="profile-edit-card">
        <div class="profile-edit-heading">
            <span class="friends-eyebrow">Account settings</span>
            <h1>Edit Profile</h1>
            <p>Update your public information and choose who can see your profile.</p>
        </div>
        <br>
        <form class="profile-edit-form" action="/profile/edit" method="POST" enctype="multipart/form-data">

            <div style="text-align: center; margin-bottom: 20px;">
                <label for="avatar" class="avatar-upload-container">
                    <img src="<%= user.avatarUrl %>" alt="Profile Picture" class="avatar-edit-img" id="avatarPreview">

                    <div class="avatar-hover-overlay">
                        <span>Change</span>
                    </div>
                    <input type="file" id="avatar" name="avatar" accept="image/*" style="display: none;">
                </label>
    
    <br>
    
    <input type="hidden" name="removeAvatar" id="removeAvatarInput" value="false">
    
    <button type="button" id="removeAvatarBtn" style="margin-top: 10px; background: transparent; color: var(--danger); border: none; cursor: pointer; text-decoration: underline; font-weight: 500;">
        Remove Picture
    </button>
</div>

<script>
    const avatarInput = document.getElementById('avatar');
    const avatarPreview = document.getElementById('avatarPreview');
    const removeAvatarBtn = document.getElementById('removeAvatarBtn');
    const removeAvatarInput = document.getElementById('removeAvatarInput');
    
    const defaultAvatarUrl = "/images/default-avatar.png"; 

    avatarInput.addEventListener('change', function(event) {
        const file = event.target.files[0];
        if (file) {
            avatarPreview.src = URL.createObjectURL(file);
            removeAvatarInput.value = "false";
        }
    });

    removeAvatarBtn.addEventListener('click', function() {
        avatarPreview.src = defaultAvatarUrl;
        avatarInput.value = "";
        removeAvatarInput.value = "true";
    });
</script>

            <div class="profile-form-field">
                <label for="displayName">Display name</label>
                <input
                    type="text"
                    id="displayName"
                    name="displayName"
                    value="<%= user.displayName %>"
                    required
                >
            </div>

            <div class="profile-form-field">
                <label for="city">City</label>
                <input
                    type="text"
                    id="city"
                    name="city"
                    value="<%= user.city || '' %>"
                    required
                >
            </div>

            <div class="profile-form-field">
                <label for="interests">Interests</label>
                <input
                    type="text"
                    id="interests"
                    name="interests"
                    value="<%= user.interests ? user.interests.join(', ') : '' %>"
                    placeholder="Running, photography, gaming"
                >
                <small>Separate interests with commas.</small>
            </div>

            <fieldset class="privacy-choice">
                <legend>Account privacy</legend>

                <label class="privacy-option">
                    <input
                        type="radio"
                        name="accountPrivacy"
                        value="public"
                        <%= user.isPrivate === true ? '' : 'checked' %>
                    >
                    <span>
                        <strong>Public account</strong>
                        <small>Anyone can see your profile and posts. Adding you as a friend is immediate.</small>
                    </span>
                </label>

                <label class="privacy-option">
                    <input
                        type="radio"
                        name="accountPrivacy"
                        value="private"
                        <%= user.isPrivate === true ? 'checked' : '' %>
                    >
                    <span>
                        <strong>Private account</strong>
                        <small>People must send a friend request before they can see your profile details and posts.</small>
                    </span>
                </label>
            </fieldset>

            <div class="profile-edit-actions">
                <a class="friend-btn friend-btn-secondary friend-btn-link" href="/users/<%= user._id %>">Cancel</a>
                <button class="friend-btn" type="submit">Save changes</button>
            </div>
        </form>

        <div class="danger-zone">
            <h2>Delete account</h2>
            <p>This permanently removes your account and removes you from everyone else's friend lists and requests.</p>

            <form
                class="friend-action-form"
                action="/profile/delete"
                method="POST"
                onsubmit="return confirm('Are you sure you want to delete your account? This action cannot be undone!');"
            >
                <button class="friend-btn friend-btn-danger" type="submit">Delete my account</button>
            </form>
        </div>
    </div>
</section>
