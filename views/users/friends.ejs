<section class="people-page">
    <div class="people-heading">
        <div>
            <span class="friends-eyebrow">Your network</span>
            <h1>Friends</h1>
            <p>People you have connected with in City Community.</p>
        </div>

        <a class="friends-feed-link" href="/feed/friends">View friends feed</a>
    </div>

    <%- include("_tabs", { activeTab, incomingRequestCount }) %>
    <%- include("_status", { status }) %>

    <% if (friends.length === 0) { %>
        <div class="friends-empty">
            <h2>Your friends list is empty</h2>
            <p>Discover community members and add someone you know.</p>
            <a class="friend-btn friend-btn-link" href="/users">Discover people</a>
        </div>
    <% } else { %>
        <div class="people-grid">
            <% friends.forEach(u => { %>
                <article class="person-card">
                    <a class="person-avatar-link" href="/users/<%= u._id %>">
                        <img
                            class="person-avatar"
                            src="<%= u.avatarUrl || '/images/default-avatar.png' %>"
                            alt="<%= u.displayName %>'s avatar"
                        >
                    </a>

                    <div class="person-card-body">
                        <div class="person-title-row">
                            <div>
                                <a class="person-name" href="/users/<%= u._id %>">
                                    <%= u.displayName %>
                                </a>
                                <div class="person-username">@<%= u.username %></div>
                            </div>

                            <span class="privacy-badge <%= u.isPrivate ? 'is-private' : 'is-public' %>">
                                <%= u.isPrivate ? 'Private' : 'Public' %>
                            </span>
                        </div>

                        <p class="person-city"><%= u.city || 'City not set' %></p>

                        <div class="person-card-footer">
                            <a href="/users/<%= u._id %>" class="profile-link">View profile</a>
                            <%- include("_friendAction", {
                                u,
                                returnTo: "/users/friends"
                            }) %>
                        </div>
                    </div>
                </article>
            <% }) %>
        </div>
    <% } %>
</section>
